{
  "name": "hotel-booking-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4860",
    "build": "next build",
    "start": "next start --port 4860",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hotelbeds:sync": "tsx --conditions=react-server scripts/hotelbeds-sync.ts",
    "hotelbeds:smoke": "tsx --conditions=react-server scripts/hotelbeds-smoke.ts",
    "tourmind:sync": "tsx --conditions=react-server scripts/tourmind-sync.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "portal:sync": "tsx scripts/sync-portal.ts",
    "tourmind:smoke": "tsx --conditions=react-server scripts/tourmind-smoke.ts",
    "suppliers:conformance": "tsx --conditions=react-server scripts/supplier-conformance.ts",
    "qa:search": "tsx scripts/search-qa.ts",
    "qa:booking": "tsx scripts/booking-qa.ts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
