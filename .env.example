# ---------------------------------------------------------------------------
# Hotelbeds (HBX Group) APItude — Hotels
#
# Copy this file to .env.local and fill in the two credential values.
# .env.local is git-ignored and must never be committed. The key and secret are
# read on the server only; nothing here reaches the browser bundle.
#
# Get the values from https://developer.hotelbeds.com/dashboard → your
# application → API key and Secret for the Hotel API.
# ---------------------------------------------------------------------------

HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# Test environment by default. Switch to https://api.hotelbeds.com only after
# the integration has passed certification.
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# Optional overrides — the defaults match the documented APItude contract.
# HOTELBEDS_BOOKING_API=/hotel-api/1.0
# HOTELBEDS_CONTENT_API=/hotel-content-api/1.0
# HOTELBEDS_AVAILABILITY_PATH=/hotels
# HOTELBEDS_LANGUAGE=ENG

# Local guard against exhausting the allowance. Evaluation keys permit 50
# requests per day and answer 403 beyond that; the app falls back to its own
# sources before reaching the limit.
HOTELBEDS_DAILY_QUOTA=50

# Never below 60000: the supplier's own guidance for booking confirmation.
# HOTELBEDS_BOOKING_TIMEOUT_MS=65000
# HOTELBEDS_SEARCH_TIMEOUT_MS=20000

# Commercial policy (scope decision D-03). Percentage added to the supplier's
# net rate to form the customer-facing price.
PLATFORM_MARKUP_PERCENT=12

# Price tolerance sent with a booking so a trivial supplier-side movement does
# not fail the order. The customer-facing acceptance gate for material change
# runs before this.
HOTELBEDS_TOLERANCE_PERCENT=2

# Prefix for the client reference sent to the supplier, used for reconciliation.
HOTELBEDS_CLIENT_REFERENCE=NAZIL

# Public site URL used for canonical links and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- TourMind (TMS) Hotel Distribution API -------------------------------
# The second live supplier. Leave blank to run on the simulated sources.
# Test credentials from their docs are tms_test / tms_test / tms_test.
#
# Note: their published test host is plain HTTP and this API sends the
# password in the request body, so the client defaults to HTTPS. Only
# override TOURMIND_BASE_URL to an http:// origin deliberately, and never
# with production credentials.
TOURMIND_AGENT_CODE=
TOURMIND_USERNAME=
TOURMIND_PASSWORD=
TOURMIND_BASE_URL=https://developers.tourmind.cn
# Rates are nationality-priced; this is the default guest nationality.
TOURMIND_NATIONALITY=PK
TOURMIND_AGENT_REF_PREFIX=SPT

# Their catalogue must be synced before a single rate can be shown — a search
# only prices properties we have already mapped to one of our cities:
#   npm run tourmind:sync -- --countries=AE,SA,PK
#   npm run tourmind:smoke -- --city dubai        (add --book to book and cancel)
#
# Timeouts, measured against their server rather than guessed. Availability for
# twenty hotels is a four-megabyte response; the re-check before payment runs to
# six seconds and must not share the browse budget, because losing it means
# booking a rate nobody confirmed.
# TOURMIND_SEARCH_TIMEOUT_MS=12000
# TOURMIND_PREBOOK_TIMEOUT_MS=25000
# TOURMIND_BOOKING_TIMEOUT_MS=60000
# TOURMIND_CATALOGUE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Agency portal (B2B)
#
# Signs the agent session cookie. Any value with real entropy will do —
# `openssl rand -base64 32` is fine. It is required in production: without it
# the app refuses to start a session rather than fall back to a constant every
# reader of the source would know, which would let anyone forge a session and
# read another agency's contracted rates.
#
# Rotating it signs every agent out. That is the intended behaviour.
# ---------------------------------------------------------------------------

AGENCY_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Super admin console
#
# Comma-separated operator emails. With none set the console cannot be signed
# into at all, which is the right default: it can cancel any customer's booking
# and change what every agency is charged.
#
# Operators are named here rather than stored in the database on purpose — a
# privilege that can be granted by writing a row is a privilege anyone who can
# write a row already has.
# ---------------------------------------------------------------------------

PLATFORM_ADMIN_EMAILS=

# Signs the operator session cookie. Falls back to AGENCY_SESSION_SECRET when
# unset; required in production one way or the other.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Demo sign-in code
#
# When set, every sign-in — traveller, agent and operator — accepts this code
# instead of a random one, and accepts it without an issued entry.
#
# With a shared store configured below, codes already survive the instance that
# issued them, so this is a convenience for handing a demo to someone rather
# than a workaround for anything.
#
# It is a shared secret that is not secret. NEVER set it on a deployment
# holding real bookings or real money — with it set, knowing an email address
# is the whole of signing in as that person. Leave it empty and codes stay
# random and single-use.
# ---------------------------------------------------------------------------

DEMO_OTP=

# ---------------------------------------------------------------------------
# Shared storage
#
# Bookings, agency credit, support cases, sign-in codes and the operator audit
# log go through one driver. With nothing set here that driver is the local
# filesystem, which is correct on a machine with a disk and a lie on a lambda:
# the directory is scratch space that dies with the container, so a booking
# taken by one instance is invisible to the next and gone on a cold start.
#
# Setting these two switches every store to Redis over its REST API — Vercel KV,
# Upstash, or anything else speaking that protocol — which is reachable from a
# lambda and shared between them. Nothing else changes; the console reports
# which driver is live on Platform → Environment.
#
# Both must be set. A URL without a token is treated as not configured rather
# than as a store that fails every read.
#
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as aliases,
# which is what Upstash's own integration injects.
#
# One honest limitation: a document is read, changed and written whole, so two
# instances writing the same document in the same instant keep the later one.
# That is stated on the console too. The fix for a platform at real volume is a
# database with row-level writes, not a lock over a key-value store.
# ---------------------------------------------------------------------------

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Where the filesystem driver keeps its documents. Defaults to .data in the
# project root; tests point it at a temporary directory.
# NAZIL_DATA_DIR=

# ---------------------------------------------------------------------------
# Scheduled work
#
# The hold engine has a second half that has to run on a timer: warn an agency
# forty-eight hours before a hold's deadline, then release the ones nobody
# issued. A hold is a real supplier booking, so a sweep that stops running
# turns into a supplier invoice — quietly, with no error anywhere.
#
# Vercel Cron calls /api/cron/holds every fifteen minutes (see vercel.json) and
# authenticates with this secret as `Authorization: Bearer <CRON_SECRET>`.
# Without it the endpoint refuses everyone except a signed-in operator, because
# anyone who could trigger it at will could cancel every outstanding hold.
#
# `openssl rand -base64 32` is fine.
# ---------------------------------------------------------------------------

CRON_SECRET=

# ---------------------------------------------------------------------------
# Separate front ends
#
# The agent portal and the operator console now have their own deployments,
# and the backend has its own repository. Two variables carry that.
#
# On a FRONT END: API_ORIGIN names the backend, and `next.config.ts` rewrites
# /api to it. The browser then only ever calls this origin, so there is no
# preflight and no third-party cookie. It defaults to the local backend, so a
# clone needs no configuration.
#
# NEXT_PUBLIC_API_URL is the other way of doing it — an absolute origin inlined
# into the browser bundle — and is only for a front end served with no proxy in
# front of it. It needs the CORS and cookie settings below; the rewrite needs
# neither. Prefer the rewrite.
#
# On the BACKEND: PORTAL_ORIGINS lists the front ends allowed to call it from a
# browser, comma separated and exact (scheme and port included). An origin not
# on the list gets no CORS headers at all, so the browser blocks the read and a
# prober learns nothing.
#
# Setting PORTAL_ORIGINS also switches the session cookies to
# `SameSite=None; Secure`, because a cookie another origin's page must send
# cannot be `Lax`. Browsers only accept `Secure` over HTTPS — localhost counts
# as secure, so local development works, but a plain-HTTP host that is not
# localhost will silently drop every session. Serve the backend over HTTPS.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_API_URL=https://api.travelandmore.example
# PORTAL_ORIGINS=https://agents.travelandmore.example,https://admin.travelandmore.example

# ---------------------------------------------------------------------------
# Test phase only: show which wholesaler each result came from.
#
# §9.4 keeps supplier identity off consumer and trade responses. This puts a
# badge on each result card naming the source, so the two catalogues can be
# checked against each other during acceptance testing. It exposes nothing new
# — the canonical slug has always carried the source in its prefix — and the
# revert is deleting this variable rather than finding commented-out code.
#
# Set to exactly "1" to enable. Anything else, including "0", leaves it off.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SHOW_SUPPLIER=1
